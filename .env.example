# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Secret key for server-side Stripe payment checkout sessions.
STRIPE_SECRET_KEY=""

# STRIPE_PUBLISHABLE_KEY: Optional public key for client-side Stripe elements.
STRIPE_PUBLISHABLE_KEY=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# STRIPE_WEBHOOK_SECRET: Optional secret for verifying incoming Stripe webhooks.
STRIPE_WEBHOOK_SECRET=""

# GOOGLE_MAPS_API_KEY: Key for interactive maps, safe pull-over navigation, and jurisdiction geocoding.
VITE_GOOGLE_MAPS_API_KEY=""

# FIREBASE CONFIGURATION (Client & Server):
FIREBASE_API_KEY=""
VITE_FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
